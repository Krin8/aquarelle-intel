generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Brand {
  id                   String              @id @default(cuid())
  name                 String
  website              String
  corporateUrl         String?
  linkedinUrl          String?
  logoUrl              String?
  status               String              @default("discovered")
  customerType         String              @default("new")
  region               String              @default("Global")
  segment              String?
  priceRange           String?
  complianceNotes      String?
  description          String?
  lastScrapedAt        DateTime?
  dataFreshness        Int                 @default(0)
  matchScore           Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  marketGrade          String?
  pipelineData         String?
  pipelineScore        Int?
  city                 String?
  countryOfOrigin      String?
  parentCompany        String?
  productType          String?
  retailPriceMensShirt String?
  state                String?
  storesCount          Int?
  turnover             String?
  emailDomain          String?
  emailPattern         String?
  targetAudience       String?
  aiAnalyses           AIAnalysis[]
  competitors          CompetitorProfile[] @relation("BrandCompetitors")
  contacts             Contact[]
  documents            Document[]
  ecosystemNodes       EcosystemNode[]
  feedbackLoops        FeedbackLoop[]
  notes                Note[]
  products             Product[]
  salesOpportunities   SalesOpportunity[]
  scrapeLogs           ScrapeLog[]
  suppliers            SupplierProfile[]   @relation("BrandSuppliers")

  @@index([status])
  @@index([region])
}

model Product {
  id         String  @id @default(cuid())
  brandId    String
  name       String
  category   String?
  priceMin   Float?
  priceMax   Float?
  fit        String?
  material   String?
  season     String?
  imageUrl   String?
  sourceUrl  String?
  confidence Float   @default(0.5)
  currency   String? @default("USD")
  localPrice Float?
  fabricTag  String?
  brand      Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model Contact {
  id                        String             @id @default(cuid())
  brandId                   String
  name                      String
  role                      String?
  department                String?
  seniority                 String?
  email                     String?
  phone                     String?
  linkedinUrl               String?
  officeLocation            String?
  reportingStructure        String?
  mutualConnections         String?
  buyerType                 String             @default("unknown")
  type                      String             @default("direct")
  confidenceScore           Float              @default(0.3)
  source                    String             @default("website")
  areasOfResponsibility     String?
  productCategories         String?
  brandsManaged             String?
  previousEmployers         String?
  yearsInRole               Int?
  sustainabilityInitiatives String?
  procurementPriorities     String?
  publicTalks               String?
  certifications            String?
  languages                 String?
  relevanceScore            Int?
  isVerified                Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  verificationStatus        String?
  firstName                 String?
  lastName                  String?
  middleName                String?
  brand                     Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  outreachStrategy          OutreachStrategy?
  targetEdges               RelationshipEdge[] @relation("TargetEdges")
  sourceEdges               RelationshipEdge[] @relation("SourceEdges")

  @@index([brandId])
}

model AIAnalysis {
  id             String   @id @default(cuid())
  brandId        String
  analysisType   String
  prompt         String
  response       String
  structuredData String?
  modelUsed      String   @default("llama3.1:8b")
  tokensUsed     Int?
  feedbackRating String?
  createdAt      DateTime @default(now())
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([analysisType])
}

model ScrapeLog {
  id              String   @id @default(cuid())
  brandId         String
  url             String
  method          String   @default("cheerio")
  status          String   @default("pending")
  contentHash     String?
  rawContentPath  String?
  errorMessage    String?
  pageTitle       String?
  metaDescription String?
  contentLength   Int?
  scrapedAt       DateTime @default(now())
  scrapedData     String?
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model Note {
  id        String   @id @default(cuid())
  brandId   String
  content   String
  category  String   @default("general")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model Region {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?
}

model PitchTemplate {
  id        String   @id @default(cuid())
  name      String
  prompt    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  brandId   String
  type      String
  title     String
  url       String
  scrapedAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model Integration {
  id          String    @id @default(cuid())
  provider    String    @unique
  status      String    @default("disconnected")
  lastSyncAt  DateTime?
  accessToken String?
  tenantId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EcosystemNode {
  id            String                  @id @default(cuid())
  seedBrandId   String
  name          String
  type          String
  url           String?
  description   String?
  crawlStatus   String                  @default("pending")
  depth         Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  seedBrand     Brand                   @relation(fields: [seedBrandId], references: [id], onDelete: Cascade)
  incomingEdges EcosystemRelationship[] @relation("TargetNode")
  outgoingEdges EcosystemRelationship[] @relation("SourceNode")

  @@unique([seedBrandId, name])
  @@index([seedBrandId])
}

model EcosystemRelationship {
  id           String        @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  relationType String
  evidence     String?
  createdAt    DateTime      @default(now())
  targetNode   EcosystemNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  sourceNode   EcosystemNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, relationType])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model CompetitorProfile {
  id                   String                  @id @default(cuid())
  targetBrandId        String
  name                 String
  website              String
  industry             String?
  targetCustomers      String?
  businessModel        String?
  marketPosition       String?
  swotStrengths        String?
  swotWeaknesses       String?
  swotOpps             String?
  swotThreats          String?
  reasoning            String?
  depth                Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  socialLinks          String?
  city                 String?
  countryOfOrigin      String?
  parentCompany        String?
  productType          String?
  retailPriceMensShirt String?
  state                String?
  storesCount          Int?
  turnover             String?
  gaps                 CompetitorGap[]
  targetBrand          Brand                   @relation("BrandCompetitors", fields: [targetBrandId], references: [id], onDelete: Cascade)
  scores               CompetitorScoreMetric[]
  snapshots            CompetitorSnapshot[]

  @@unique([targetBrandId, name])
  @@index([targetBrandId])
}

model CompetitorScoreMetric {
  id           String            @id @default(cuid())
  competitorId String
  metricName   String
  score        Float
  evidence     String?
  confidence   Float             @default(0.8)
  timestamp    DateTime          @default(now())
  competitor   CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([metricName])
}

model CompetitorSnapshot {
  id             String            @id @default(cuid())
  competitorId   String
  timestamp      DateTime          @default(now())
  pricingData    String?
  techStack      String?
  employeeCount  Int?
  organicTraffic Int?
  competitor     CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([timestamp])
}

model CompetitorGap {
  id           String            @id @default(cuid())
  competitorId String
  gapType      String
  description  String
  severity     String
  opportunity  String?
  createdAt    DateTime          @default(now())
  competitor   CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
}

model SalesOpportunity {
  id                  String   @id @default(cuid())
  targetBrandId       String
  status              String   @default("Identified")
  expectedValue       String?
  probability         Float?
  recommendedProducts String?
  recommendedServices String?
  primaryGapTarget    String?
  pitchSummary        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  brand               Brand    @relation(fields: [targetBrandId], references: [id], onDelete: Cascade)

  @@index([targetBrandId])
}

model FeedbackLoop {
  id              String   @id @default(cuid())
  targetBrandId   String?
  interactionType String
  category        String
  content         String
  sentiment       String?
  impactScore     Float?
  createdAt       DateTime @default(now())
  brand           Brand?   @relation(fields: [targetBrandId], references: [id])

  @@index([targetBrandId])
  @@index([category])
}

model RelationshipEdge {
  id              String   @id @default(cuid())
  sourceType      String
  sourceId        String
  targetType      String
  targetId        String
  relationType    String
  strengthScore   Int      @default(5)
  confidenceScore Float    @default(0.5)
  evidence        String?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  targetContact   Contact  @relation("TargetEdges", fields: [targetId], references: [id])
  sourceContact   Contact  @relation("SourceEdges", fields: [sourceId], references: [id])

  @@index([sourceId, targetId])
  @@index([relationType])
}

model OutreachStrategy {
  id                   String   @id @default(cuid())
  contactId            String   @unique
  whyMatters           String?
  likelyPriorities     String?
  potentialChallenges  String?
  relevantCapabilities String?
  valueProposition     String?
  objections           String?
  recommendedPath      String?
  recommendedMessage   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  contact              Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  passwordHash          String
  fullName              String
  phone                 String?
  department            String?
  jobTitle              String?
  officeLocation        String?
  businessJustification String?
  managerName           String?
  employeeId            String?
  status                String     @default("pending")
  role                  String     @default("Guest")
  permissions           String?
  mfaEnabled            Boolean    @default(false)
  mfaSecret             String?
  lastLoginAt           DateTime?
  lastActivityAt        DateTime?
  loginCount            Int        @default(0)
  failedLogins          Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  auditLogs             AuditLog[]
  sessions              Session[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  device         String?
  browser        String?
  os             String?
  city           String?
  country        String?
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  status         String   @default("active")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  resource      String?
  resourceType  String?
  previousValue String?
  newValue      String?
  ipAddress     String?
  device        String?
  status        String   @default("success")
  reason        String?
  riskScore     Int      @default(0)
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SecurityEvent {
  id             String   @id @default(cuid())
  eventType      String
  emailAttempted String?
  ipAddress      String?
  userAgent      String?
  description    String?
  severity       String   @default("low")
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([ipAddress])
  @@index([eventType])
}

model SupplierProfile {
  id                        String        @id @default(cuid())
  targetBrandId             String
  name                      String
  type                      String
  location                  String?
  companyOverview           String?
  productsManufactured      String?
  categoriesHandled         String?
  manufacturingCapabilities String?
  fabricExpertise           String?
  capacity                  String?
  productionScale           String?
  countriesServed           String?
  automationLevel           String?
  digitalMaturity           String?
  qualityCertifications     String?
  complianceCertifications  String?
  sustainabilityInitiatives String?
  esgPerformance            String?
  leadTime                  String?
  speedToMarket             String?
  moq                       String?
  flexibility               String?
  pricingPosition           String?
  deliveryPerformance       String?
  customerPortfolio         String?
  brandReputation           String?
  strengths                 String?
  weaknesses                String?
  uniqueCapabilities        String?
  competitiveAdvantages     String?
  riskFactors               String?
  financialHealth           String?
  brandRelationship         String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  website                   String?
  supplierGaps              SupplierGap[]
  brand                     Brand         @relation("BrandSuppliers", fields: [targetBrandId], references: [id], onDelete: Cascade)
  winStrategy               WinStrategy?

  @@unique([targetBrandId, name])
  @@index([targetBrandId])
}

model WinStrategy {
  id                        String          @id @default(cuid())
  supplierId                String          @unique
  whyCustomerUsesThem       String?
  businessValueProvided     String?
  likelyPainPoints          String?
  vulnerabilities           String?
  whatAquarelleDoesBetter   String?
  capabilitiesToEmphasize   String?
  capabilitiesToAvoid       String?
  matchingAquarelleProducts String?
  sustainabilityToHighlight String?
  expectedObjections        String?
  recommendedResponses      String?
  recommendedSalesStrategy  String?
  estimatedWinProbability   Float?
  confidenceScore           Float?
  aiReasoning               String?
  createdAt                 DateTime        @default(now())
  supplier                  SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SupplierGap {
  id                   String          @id @default(cuid())
  supplierId           String
  gapCategory          String
  description          String
  canAquarelleSolveIt  Boolean         @default(true)
  aquarelleCapability  String?
  expectedRoi          String?
  businessImpact       String?
  implementationEffort String?
  priority             String?
  confidence           Float?
  createdAt            DateTime        @default(now())
  supplier             SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
